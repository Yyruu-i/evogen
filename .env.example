# ═══════════════════════════════════════════════════════
# EvoGen（进化灵眸）环境变量配置模板
# 复制此文件为 .env 并填入你的密钥
#   cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── LLM 配置（必填）──────────────────────────────────
# DeepSeek API Key
# 获取方式：访问 https://platform.deepseek.com → 注册/登录 → API Keys → 创建
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 提供商（可选，默认 deepseek）
LLM_PROVIDER=deepseek

# LLM 模型名称（可选，默认 deepseek-v4-pro）
LLM_MODEL=deepseek-v4-pro

# LLM API 地址（可选，默认 DeepSeek 官方）
LLM_BASE_URL=https://api.deepseek.com

# ── Web 搜索（可选）──────────────────────────────────
# Tavily Search API Key
# 获取方式：访问 https://tavily.com → 注册 → API Keys → 创建免费额度
# TAVILY_API_KEY=your_tavily_api_key_here

# ── Web 内容抽取（可选）──────────────────────────────
# Jina AI Reader API Key
# 获取方式：访问 https://jina.ai → 注册 → API Keys → 创建
# JINA_API_KEY=your_jina_api_key_here

# ── 服务端口（可选）──────────────────────────────────
# 后端 API 端口（默认 8100）
API_PORT=8100

# ── 日志级别（可选）──────────────────────────────────
# debug | info | warning | error（默认 info）
LOG_LEVEL=INFO
